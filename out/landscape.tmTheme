<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 横版独立配色：深灰代码、深蓝关键字、紫色常量、灰绿注释。 -->
<plist version="1.0">
<dict>
  <key>name</key><string>Landscape</string>
  <key>settings</key>
  <array>
    <dict><key>settings</key><dict><key>foreground</key><string>#20262d</string></dict></dict>
    <dict><key>scope</key><string>keyword, storage, meta.preprocessor</string><key>settings</key><dict><key>foreground</key><string>#294f78</string></dict></dict>
    <dict><key>scope</key><string>constant.numeric, constant.language</string><key>settings</key><dict><key>foreground</key><string>#705084</string></dict></dict>
    <dict><key>scope</key><string>string, constant.character</string><key>settings</key><dict><key>foreground</key><string>#8a493b</string></dict></dict>
    <dict><key>scope</key><string>comment</string><key>settings</key><dict><key>foreground</key><string>#596e60</string></dict></dict>
  </array>
</dict>
</plist>
